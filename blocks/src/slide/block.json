{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sliderpress/slide",
	"version": "0.1.0",
	"title": "Slide",
	"category": "media",
	"icon": "format-image",
	"description": "A single slide inside a SliderPress Slideshow block.",
	"textdomain": "sliderpress",
	"parent": [ "sliderpress/slideshow" ],
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"attributes": {
		"imageId": {
			"type": "integer",
			"default": 0
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"altText": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"lock": false
	}
}